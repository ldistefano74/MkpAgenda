# Copy to .env and fill in. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True

# PostgreSQL (local or Neon). TEST_DATABASE_URL is only used when running tests.
DATABASE_URL=postgresql://user:password@localhost:5432/MkpAgenda
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/MkpAgenda

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to log in. Empty = nobody can log in.
ALLOWED_LOGIN_EMAILS=you@example.com

# Optional
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS_EXTRA=https://my-domain.com
# LOGIN_REDIRECT_URL=/
# LOGOUT_REDIRECT_URL=/
